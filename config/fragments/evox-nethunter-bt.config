# ============================================================================
# evox-nethunter-bt.config
# NetHunter Bluetooth Fragment — marble / marblein (POCO F5)
# ============================================================================
# Kernel:     Evolution-X-Devices/kernel_xiaomi_sm8450 @ cnb  commit 4a234e4dff23
# KMI:        android12-5.10
# Branch:     feature/marble-evox-nethunter-daily
#
# Authoritative reference:
#   https://www.kali.org/docs/nethunter/nethunter-kernel-3-config-2/
#   "Configuring the Kernel - Network" (Bluetooth section)
#
# IMPORTANT CONSTRAINT:
#   marble's internal Bluetooth uses Qualcomm stack (wcnss/btfmslim via HCI
#   UART). It is a vendor driver. These additions add EXTERNAL USB Bluetooth
#   support only. The internal BT stack is NOT modified.
#
# ── USB Bluetooth HCI ────────────────────────────────────────────────────────
# Adds support for external USB Bluetooth adapters via USB OTG.
# Internal Qualcomm BT is unaffected (different HCI path).
CONFIG_BT_HCIBTUSB=y                     # [NH-REQUIRED] USB BT HCI driver (external adapters)
CONFIG_BT_HCIBTUSB_BCM=y               # [NH-REQUIRED] Broadcom protocol (CSR, Parani, etc.)
CONFIG_BT_HCIBTUSB_RTL=y               # [NH-REQUIRED] Realtek protocol (RTL8761, etc.)

# ── HCI UART ─────────────────────────────────────────────────────────────────
# Note: marble's internal BT already uses HCI UART via Qualcomm FM/BT slim.
# Enabling generic CONFIG_BT_HCIUART should not conflict — Qualcomm uses a
# specific btfmslim/WCN driver path separate from the generic HCI UART path.
CONFIG_BT_HCIUART=y                      # [NH-REQUIRED] Generic HCI UART driver
CONFIG_BT_HCIUART_H4=y                  # [NH-REQUIRED] H4 UART protocol

# ── USB BT Chipset-specific Drivers ─────────────────────────────────────────
CONFIG_BT_HCIBCM203X=y                  # [NH-RECOMMENDED] BCM203x USB (older Broadcom)
CONFIG_BT_HCIBPA10X=y                   # [NH-RECOMMENDED] BPA-10x (BT analyzer USB)
CONFIG_BT_HCIBFUSB=y                    # [NH-RECOMMENDED] BlueFRITZ! USB

# ── Virtual HCI ──────────────────────────────────────────────────────────────
# Used for NetHunter Bluetooth Arsenal virtual device emulation.
CONFIG_BT_HCIVHCI=y                     # [NH-REQUIRED] Virtual HCI device

# ── Android Binder ───────────────────────────────────────────────────────────
# Required for NetHunter chroot / container environments.
# Already present on marble, documented here for completeness.
# CONFIG_ANDROID_BINDER_IPC=y           # [ALREADY_PRESENT] — do not re-set

# ── STATUS ────────────────────────────────────────────────────────────────────
# Internal Qualcomm BT: UNCHANGED — CONFIG CONFIRMED
# External USB BT:      CONFIG CONFIRMED — BUILD + HARDWARE TESTING required
# BT Arsenal:           CONFIG CONFIRMED — RUNTIME TESTING required
