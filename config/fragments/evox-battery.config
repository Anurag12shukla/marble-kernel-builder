# ============================================================================
# evox-battery.config
# Battery / Efficiency Fragment — marble / marblein (POCO F5)
# ============================================================================
# Kernel:     Evolution-X-Devices/kernel_xiaomi_sm8450 @ cnb  commit 4a234e4dff23
# KMI:        android12-5.10
# Branch:     feature/marble-evox-nethunter-daily
#
# Philosophy (per spec §12):
#   - DO NOT use aggressive benchmark-oriented CPU tuning
#   - DO NOT disable thermal protections
#   - DO NOT force min/max frequencies
#   - DO NOT apply generic Snapdragon tuning from another device
#   - Preserve Qualcomm device-specific thermal/PM implementation
#   - Conservatively extend the existing GKID base
#
# ── Memory Management (extends GKID base) ────────────────────────────────────
# MGLRU is already enabled by evox-gkid-performance.config.
# Retained here:
# CONFIG_LRU_GEN=y                  [ALREADY_PRESENT from GKID base]
# CONFIG_LRU_GEN_ENABLED=y          [ALREADY_PRESENT from GKID base]

# PSI — Pressure Stall Information
# Already present on GKI 5.10 Android 12. Enables LMKD to make better decisions.
# If not present, this enables it safely.
CONFIG_PSI=y                             # [NH-RECOMMENDED] PSI for LMKD integration

# CONFIG_PSI_DEFAULT_DISABLED is not set # Ensure PSI is on by default

# ── ZRAM / Compression ───────────────────────────────────────────────────────
# ZRAM with LZ4 is already present on marble (ALREADY_PRESENT from running config).
# Adding ZSTD as an additional algorithm option (non-default; safe additive).
CONFIG_CRYPTO_ZSTD=y                     # [PORTED] ZSTD compression for ZRAM

# ZRAM writeback: EXCLUDED per spec §13.
# Requires Android partition coordination. Risk of data loss if misconfigured.
# CONFIG_ZRAM_WRITEBACK is not set

# KSM: EXCLUDED per spec §13 (Spectre risk, GKID base already disables it).
# CONFIG_KSM is not set

# ── Transparent Huge Pages ────────────────────────────────────────────────────
# THP is already present on Android GKI 5.10 in madvise mode.
# Documented only — do not change the default.
# CONFIG_TRANSPARENT_HUGEPAGE=y     [ALREADY_PRESENT]

# ── CPU Idle ──────────────────────────────────────────────────────────────────
# Qualcomm LPM (Low Power Manager) and cpuidle drivers are Qualcomm proprietary.
# We do NOT touch these. The generic cpuidle framework is already enabled.
# No additions needed.

# ── Filesystem ────────────────────────────────────────────────────────────────
# F2FS and EROFS are retained from base.
# CONFIG_F2FS_FS=y              [ALREADY_PRESENT]
# CONFIG_EROFS_FS=y             [ALREADY_PRESENT]

# ── Crypto Extensions ────────────────────────────────────────────────────────
# SHA-512 and additional crypto modes for userspace tool acceleration.
# These are standard kernel crypto modules with no driver dependency.
CONFIG_CRYPTO_SHA512=y                   # [PORTED] SHA-512 (for hashcat/userspace tools)
CONFIG_CRYPTO_ECB=y                      # [PORTED] ECB mode
CONFIG_CRYPTO_CTR=y                      # [PORTED] CTR mode (WPA3/AES-CTR)

# ── What We Deliberately Excluded ────────────────────────────────────────────
# Per spec §18 (no NTSync, 300Hz, FullLTO, aggressive scheduler patches):
#   - NTSync: excluded
#   - CONFIG_HZ_300: excluded (evaluate on separate experimental branch)
#   - Full LTO: excluded (OOM on free runners, ThinLTO is appropriate)
#   - GPU frequency unlocker: excluded
#   - Generic Snapdragon scheduler patches: excluded
#   - Qualcomm WALT modifications: excluded (proprietary)
#   - ZRAM writeback: excluded
#   - KSM: excluded
#   - 300Hz: excluded
#   - NTSync: excluded
#
# ── STATUS ────────────────────────────────────────────────────────────────────
# PSI:          CONFIG CONFIRMED (likely ALREADY_PRESENT on GKI 5.10)
# ZSTD:         CONFIG CONFIRMED (safe additive)
# ZRAM:         CONFIG CONFIRMED (from GKID base, LZ4 primary)
# CPU/Thermal:  UNCHANGED (Qualcomm proprietary — safe)
