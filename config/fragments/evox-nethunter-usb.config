# ============================================================================
# evox-nethunter-usb.config
# NetHunter USB Gadget Fragment — marble / marblein (POCO F5)
# ============================================================================
# Kernel:     Evolution-X-Devices/kernel_xiaomi_sm8450 @ cnb  commit 4a234e4dff23
# KMI:        android12-5.10  (Linux 5.10.269)
# Device:     POCO F5 marble / marblein
# Branch:     feature/marble-evox-nethunter-daily
#
# Authoritative reference:
#   https://www.kali.org/docs/nethunter/nethunter-kernel-7-config-6/
#   "Configuring the 4.x Kernel - USB"
#   (applies to 5.x kernels identically)
#
# PARADOX-X20 reference kernel confirmed same options on marble.
#
# Each option is annotated:
#   [NH-REQUIRED]     Kali NH docs mark as required
#   [NH-RECOMMENDED]  Kali NH docs recommend
#   [SAFE-GKI]        Verified safe on GKI 5.10 Android 12 base
#   [ALREADY_PRESENT] Confirmed in marble running kernel config
#   [PORTED]          Added by this fragment
#   [SAFETY]          Guards Android USB functionality
#
# ── USB CDC ACM (virtual serial port over USB) ───────────────────────────────
# NH-REQUIRED: needed for generic serial and ACM-based attack payloads.
# CONFIG_USB_ACM is in the host driver path (USB serial from external device).
# Android-side uses configfs ACM function below.
CONFIG_USB_ACM=y                         # [NH-REQUIRED][PORTED] USB ACM host class driver

# ── USB Gadget — ConfigFS ────────────────────────────────────────────────────
# NH-REQUIRED: configfs-based gadget framework for 4.x/5.x kernels.
# Android's USB gadget already uses configfs; these additions extend it.
# Do NOT disable CONFIG_USB_CONFIGFS — it is required by Android ADB/MTP.
CONFIG_USB_CONFIGFS=y                    # [ALREADY_PRESENT] Android ADB/MTP uses this

# Generic serial bulk in/out — NetHunter DuckHunter / HID requires this
CONFIG_USB_CONFIGFS_SERIAL=y             # [NH-REQUIRED][PORTED]

# Abstract Control Model (CDC ACM) — modem-style serial over USB
CONFIG_USB_CONFIGFS_ACM=y               # [NH-REQUIRED][PORTED]

# Object Exchange Model (CDC OBEX) — optional, low risk
CONFIG_USB_CONFIGFS_OBEX=y              # [NH-RECOMMENDED][PORTED]

# Network Control Model (CDC NCM) — USB tethering, RNDIS alternative
CONFIG_USB_CONFIGFS_NCM=y               # [NH-REQUIRED][PORTED]

# Ethernet Control Model (CDC ECM) — USB Ethernet gadget
CONFIG_USB_CONFIGFS_ECM=y               # [NH-REQUIRED][PORTED]

# CDC ECM subset — for hosts without full ECM support
CONFIG_USB_CONFIGFS_ECM_SUBSET=y        # [NH-RECOMMENDED][PORTED]

# RNDIS — Remote NDIS; Windows USB networking compatibility
CONFIG_USB_CONFIGFS_RNDIS=y             # [NH-REQUIRED][PORTED]

# Ethernet Emulation Model (EEM) — lightweight ethernet gadget
CONFIG_USB_CONFIGFS_EEM=y               # [NH-RECOMMENDED][PORTED]

# Mass Storage — USB drive emulation (NetHunter disk images)
# SAFE: Android already uses f_mass_storage; this enables configfs variant
CONFIG_USB_CONFIGFS_MASS_STORAGE=y      # [NH-RECOMMENDED][SAFE-GKI][PORTED]

# HID function — CRITICAL for NetHunter HID/BadUSB/DuckHunter attacks
CONFIG_USB_CONFIGFS_F_HID=y             # [NH-REQUIRED][PORTED]

# ── Android Gadget ───────────────────────────────────────────────────────────
# Android uses android_usb gadget built on top of configfs.
# Do NOT disable CONFIG_USB_GADGET; it is required for charging, ADB, MTP.
# All additions above are incremental extensions, not replacements.

# ── Safety: explicitly ensure ADB path is NOT broken ────────────────────────
# ADB uses f_adb function in the android_usb gadget path.
# No option here disables it. Safety reminder:
#   - Do NOT set CONFIG_USB_CONFIGFS_UEVENT_IGNORED=y
#   - Do NOT remove CONFIG_USB_GADGET_DOWNLOAD

# ── USB Host CDC Networking ──────────────────────────────────────────────────
# These are host-side drivers for USB-attached network adapters (OTG input).
# They do NOT affect Android's own USB output mode.
CONFIG_USB_NET_CDCETHER=y               # [NH-RECOMMENDED][PORTED] CDC Ethernet host driver
CONFIG_USB_NET_CDC_NCM=y                # [NH-RECOMMENDED][PORTED] CDC NCM host driver
CONFIG_USB_NET_RNDIS_HOST=y             # [NH-RECOMMENDED][PORTED] RNDIS host for USB tethering

# ── COMPATIBILITY NOTE ───────────────────────────────────────────────────────
# marble running kernel (verified from running-kernel.config) includes:
#   CONFIG_USB_CONFIGFS=y (confirmed)
#   CONFIG_USB_GADGET=y (confirmed)
#   CONFIG_USB_GADGET_XILINX is not set
# The configfs function additions above are safe extensions.
#
# STATUS: CONFIG CONFIRMED (build + runtime validation required)
