# ============================================================================
# Evolution X GKID Performance Config Fragment
# ============================================================================
# Applied to: Evolution-X-Devices/kernel_xiaomi_sm8450 @ cnb
# KMI:        android12-5.10
# Device:     POCO F5 marble / marblein
#
# This fragment is applied via scripts/apply-gkid-config-fragment.sh
# AFTER the standard GKI fragments (waipio_GKI, xiaomi_GKI, marble_GKI).
#
# Each option is annotated with:
#   [ALREADY_PRESENT]  — verified on running kernel, kept for documentation
#   [PORTED]           — not in running kernel, added by this fragment
#   [CONDITIONAL]      — only set when workflow input enables the feature
#   [SAFETY]           — safety/compatibility override
#
# ── Performance: Memory Management ──────────────────────────────────────────

# MGLRU — Multi-Generational LRU [PORTED]
# Available as 5.10 backport in Android GKI trees. Improves memory reclaim
# for mobile workloads (fewer cache evictions, better app retention).
# If the symbol is not available in the cnb tree, the kernel build silently
# ignores it; CI logs will expose this.
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
CONFIG_LRU_GEN_STATS=n

# ZRAM improvements [ALREADY_PRESENT — documented only]
# CONFIG_ZRAM=m is already set; LZ4 is already the primary zRAM algorithm.
# ZRAM_WRITEBACK is deliberately excluded (requires Android partition support).
# CONFIG_ZRAM_WRITEBACK is not set

# ── Performance: TCP / Network ───────────────────────────────────────────────

# Enable TCP congestion control algorithm selection [PORTED]
# Running kernel uses only Cubic. This enables BBR and Westwood+.
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR=y
CONFIG_TCP_CONG_WESTWOOD=y

# Set BBR as default congestion algorithm [PORTED]
# Falls back gracefully if BBR is not compiled; safe for mobile data + Wi-Fi.
CONFIG_DEFAULT_TCP_CONG="bbr"

# fq_codel packet scheduling [PORTED]
# Reduces bufferbloat on mobile links. No Qualcomm driver dependency.
CONFIG_NET_SCH_FQ=y
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_NET_SCH_DEFAULT=y
CONFIG_DEFAULT_FQ_CODEL=y

# ── Performance: Scheduler / CPU ────────────────────────────────────────────

# Scheduler thermal pressure [ALREADY_PRESENT — documented]
# CONFIG_SCHED_THERMAL_PRESSURE=y is already set; keep.

# SMP multi-core scheduling [ALREADY_PRESENT — documented]
# CONFIG_SCHED_MC=y is already set.

# ── Security / Root ──────────────────────────────────────────────────────────

# KSU + SUSFS [ALREADY_PRESENT — documented]
# All CONFIG_KSU_* and CONFIG_KSU_SUSFS_* are already set on running kernel.
# The build-core.yml workflow enables CONFIG_KSU and CONFIG_KSU_SUSFS via
# scripts/config. This fragment documents but does not re-set them.

# ── Safety / Compatibility ───────────────────────────────────────────────────

# KSM deliberately disabled [SAFETY]
# Running kernel has this disabled; security + Spectre risk.
# CONFIG_KSM is not set

# MODVERSIONS [ALREADY_PRESENT — required]
# CONFIG_MODVERSIONS=y is required for vendor module compatibility.
# Do not change.

# ── Conditional Features (see apply-gkid-config-fragment.sh) ────────────────
# The following are applied conditionally based on workflow inputs:
#
#   HZ_300:   CONFIG_HZ_300=y  (replaces CONFIG_HZ_250=y)
#             Only when GKID_ENABLE_HZ_300=true
#
#   NTSync:   CONFIG_NTSYNC=y
#             Only when GKID_ENABLE_NTSYNC=true
#             (Symbol availability depends on cnb tree; CI will reveal)
