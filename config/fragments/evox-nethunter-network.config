# ============================================================================
# evox-nethunter-network.config
# NetHunter Network / Namespace / Container Fragment — marble (POCO F5)
# ============================================================================
# Kernel:     Evolution-X-Devices/kernel_xiaomi_sm8450 @ cnb  commit 4a234e4dff23
# KMI:        android12-5.10
# Branch:     feature/marble-evox-nethunter-daily
#
# Covers:
#   - USB Ethernet adapters (host-side)
#   - Linux namespaces (required for chroot / container isolation)
#   - TUN/TAP (VPN support)
#   - SDR (RTL-SDR / RTL2832U — minimal, conditional)
#   - Network performance (BBR/FQ retained from GKID base)
#   - WireGuard (verify existing state)
#   - Netfilter extensions needed by NetHunter tools
#
# ── USB Ethernet (host-side) ─────────────────────────────────────────────────
# For USB OTG-attached Ethernet adapters.
# marble's internal Ethernet is not applicable; this is external adapter support.
CONFIG_USB_USBNET=y                      # [NH-RECOMMENDED] USB-to-network bridge
CONFIG_USB_RTL8150=y                     # [NH-REQUIRED] RTL8150 USB Ethernet
CONFIG_USB_RTL8152=y                     # [NH-REQUIRED] RTL8152/RTL8153 USB Ethernet
CONFIG_USB_NET_RNDIS_HOST=y              # [NH-REQUIRED] Host-side RNDIS for USB tethering/modems
                                         # (covers RTL8153: used in USB-C hubs)

# ── Namespace / Container Support ────────────────────────────────────────────
# Required for Kali chroot environment (NetHunter Chroot Manager).
# GKI 5.10 typically has most of these; listed for explicit confirmation.
CONFIG_NAMESPACES=y                      # [NH-REQUIRED] namespace subsystem
CONFIG_UTS_NS=y                          # [NH-REQUIRED] UTS namespace (hostname isolation)
CONFIG_IPC_NS=y                          # [NH-REQUIRED] IPC namespace
CONFIG_PID_NS=y                          # [NH-REQUIRED] PID namespace (needed by chroot)
CONFIG_NET_NS=y                          # [NH-REQUIRED] network namespace (nmap isolation)
CONFIG_USER_NS=y                         # [NH-RECOMMENDED] user namespace (rootless chroot)

# ── TUN/TAP (VPN) ────────────────────────────────────────────────────────────
# Required for OpenVPN, WireGuard, and network tunneling in chroot.
CONFIG_TUN=y                             # [NH-REQUIRED] TUN/TAP virtual network device

# ── WireGuard ────────────────────────────────────────────────────────────────
# GKI 5.10 includes WireGuard natively (CONFIG_WIREGUARD was upstreamed in 5.6).
# marble running kernel state: verify from running-kernel.config.
# Listed here for documentation; if already present, this is a no-op.
CONFIG_WIREGUARD=y                       # [NH-RECOMMENDED] WireGuard VPN (likely ALREADY_PRESENT)

# ── Netfilter extensions ──────────────────────────────────────────────────────
# NetHunter tools (nmap, metasploit network modules) benefit from:
CONFIG_NETFILTER=y                       # [ALREADY_PRESENT] Core netfilter
CONFIG_NF_CONNTRACK=y                    # [ALREADY_PRESENT] Connection tracking
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y   # [NH-RECOMMENDED] conntrack match in iptables
CONFIG_NETFILTER_XT_TARGET_REDIRECT=y   # [NH-RECOMMENDED] REDIRECT target (port redirect)
CONFIG_NF_NAT=y                          # [NH-RECOMMENDED] NAT framework (MASQUERADE/DNAT)
CONFIG_NF_NAT_MASQUERADE=y              # [NH-RECOMMENDED] IP masquerade

# ── SDR — RTL-SDR (RTL2832U) ─────────────────────────────────────────────────
# Per spec PRIORITY 8: minimal, only if cleanly compatible.
#
# RTL2832U requires:
#   - CONFIG_MEDIA_SUPPORT
#   - CONFIG_DVB_CORE
#   - CONFIG_DVB_USB
#   - CONFIG_DVB_USB_RTL28XXU
#
# GKI 5.10 RISK ASSESSMENT:
#   DVB/media stack on Android GKI is non-standard. Enabling it may introduce
#   symbol conflicts with Qualcomm camera/media drivers. The marble running
#   kernel shows no DVB symbols.
#
# DECISION: RTL-SDR CONFIG EXCLUDED from this build.
# Reason: DVB_CORE + DVB_USB adds ~8 new subsystem dependencies.
#   Risk of breaking Qualcomm camera/media HAL is non-trivial.
#   RTL-SDR is primarily a userspace tool (rtl_sdr) that can run without
#   in-kernel DVB — it can use the generic USB endpoint directly in userspace.
#
# CONFIG_MEDIA_SUPPORT is not set    # [EXCLUDED] DVB/media risk on GKI
# CONFIG_DVB_CORE is not set         # [EXCLUDED] same
# CONFIG_DVB_USB_RTL28XXU is not set # [EXCLUDED] same
#
# If RTL-SDR is needed in future, evaluate on dedicated experimental branch.
# The rtl-sdr userspace library approach does not require kernel changes.

# ── Performance Retention (from GKID base) ───────────────────────────────────
# These are already set by evox-gkid-performance.config; listed for clarity.
# BBR, Westwood, FQ, FQ-CoDel are RETAINED.
# No changes to existing TCP congestion configuration.
#
# CONFIG_TCP_CONG_BBR=y          [ALREADY_PRESENT from GKID base]
# CONFIG_TCP_CONG_WESTWOOD=y     [ALREADY_PRESENT from GKID base]
# CONFIG_DEFAULT_TCP_CONG="bbr"  [ALREADY_PRESENT from GKID base]
# CONFIG_NET_SCH_FQ=y            [ALREADY_PRESENT from GKID base]
# CONFIG_NET_SCH_FQ_CODEL=y      [ALREADY_PRESENT from GKID base]

# ── STATUS ────────────────────────────────────────────────────────────────────
# USB Ethernet: CONFIG CONFIRMED — BUILD + HARDWARE TESTING required
# Namespaces:   CONFIG CONFIRMED (GKI 5.10 typically has these)
# TUN/TAP:      CONFIG CONFIRMED
# WireGuard:    CONFIG CONFIRMED (likely ALREADY_PRESENT in GKI 5.10)
# SDR:          EXCLUDED — too risky on Android GKI; userspace approach preferred
