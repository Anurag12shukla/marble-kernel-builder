# ============================================================================
# evox-nethunter-wifi.config
# NetHunter External Wi-Fi Fragment — marble / marblein (POCO F5)
# ============================================================================
# Kernel:     Evolution-X-Devices/kernel_xiaomi_sm8450 @ cnb  commit 4a234e4dff23
# KMI:        android12-5.10  (Linux 5.10.269)
# Branch:     feature/marble-evox-nethunter-daily
#
# Authoritative reference:
#   https://www.kali.org/docs/nethunter/nethunter-kernel-4-config-3/
#   "Configuring the Kernel - Wifi"
#
# IMPORTANT CONSTRAINTS:
#   1. Internal Qualcomm WLAN (qca_cld3_qca6490 / cnss2) is NOT modified.
#      It is a vendor-closed binary driver loaded as a module.
#   2. cfg80211 is already present (required by internal Qualcomm WLAN).
#      Adding mac80211 is an ADDITIVE operation; it does not conflict.
#   3. CONFIG_CFG80211_WEXT: Kali NH docs recommend this. On GKI 5.10 it may
#      conflict with Android's cfg80211 usage. Marked CONDITIONAL below.
#   4. Monitor mode / injection for external USB adapters depends on the
#      specific driver's implementation; not guaranteed at CONFIG level.
#      See WIFI_INJECTION_STATUS below.
#
# STATUS LABELS:
#   [NH-REQUIRED]   Kali NH docs required
#   [NH-RECOMMENDED] Kali NH docs recommended
#   [PORTED]        Added by this fragment
#   [CONDITIONAL]   Needs build testing on GKI 5.10 before enabling
#   [MONITOR-CAPABLE] Driver supports monitor mode (per driver docs)
#   [INJECT-CAPABLE]  Driver supports injection (per driver docs, NOT tested)
#
# ── mac80211 Framework ───────────────────────────────────────────────────────
# Required for all mac80211-based USB Wi-Fi drivers below.
# The Qualcomm WLAN uses cfg80211 directly (not mac80211); no conflict.
CONFIG_CFG80211=y                        # [NH-REQUIRED][PORTED] Generic wireless configuration API
CONFIG_MAC80211=y                        # [NH-REQUIRED][PORTED] Generic 802.11 stack

# mac80211 mesh networking support
CONFIG_MAC80211_MESH=y                   # [NH-RECOMMENDED][PORTED]

# cfg80211 wireless extensions compatibility
# WARNING: On GKI 5.10 with Qualcomm WLAN, this may conflict. 
# Enabled here — if build fails, set to =n and document.
CONFIG_CFG80211_WEXT=y                   # [CONDITIONAL] Kali NH requires; GKI compat TBD

# ── Atheros USB Wi-Fi Drivers ────────────────────────────────────────────────
# Covers: TP-Link TL-WN722N (v1), ALFA AWUS036H, older Atheros USB adapters.
CONFIG_WLAN_VENDOR_ATH=y                 # [NH-REQUIRED][PORTED] Atheros vendor enable
CONFIG_ATH9K_HTC=y                       # [NH-REQUIRED][PORTED][MONITOR-CAPABLE][INJECT-CAPABLE]
                                         # AR9271-based adapters (TL-WN722N v1, ALFA AWUS036NHA)
CONFIG_CARL9170=y                        # [NH-RECOMMENDED][PORTED] AR9170 USB (ALFA AWUS036AR9170)
CONFIG_ATH6KL=y                          # [NH-RECOMMENDED][PORTED] Atheros mobile chipsets
CONFIG_ATH6KL_USB=y                      # [NH-RECOMMENDED][PORTED] ATH6KL USB interface

# ── Ralink / MediaTek USB Wi-Fi Drivers ──────────────────────────────────────
# Covers: RT73USB, RT2800USB family (most popular budget USB adapters).
CONFIG_WLAN_VENDOR_RALINK=y              # [NH-REQUIRED][PORTED] Ralink vendor enable
CONFIG_RT2X00=y                          # [NH-REQUIRED][PORTED] RT2x00 driver framework
CONFIG_RT2500USB=y                       # [NH-RECOMMENDED][PORTED] Ralink rt2500 USB
CONFIG_RT73USB=y                         # [NH-RECOMMENDED][PORTED][MONITOR-CAPABLE]
                                         # RT73-based adapters (ALFA AWUS036H)
CONFIG_RT2800USB=y                       # [NH-REQUIRED][PORTED][MONITOR-CAPABLE][INJECT-CAPABLE]
                                         # RT2870/RT3070/RT3572 family (most common NH adapters)
CONFIG_RT2800USB_RT33XX=y               # [NH-RECOMMENDED][PORTED] rt33xx device support
CONFIG_RT2800USB_RT35XX=y               # [NH-RECOMMENDED][PORTED] rt35xx device support
CONFIG_RT2800USB_RT3573=y               # [NH-RECOMMENDED][PORTED] rt3573 device support
CONFIG_RT2800USB_RT53XX=y               # [NH-RECOMMENDED][PORTED] rt53xx device support
CONFIG_RT2800USB_RT55XX=y               # [NH-RECOMMENDED][PORTED] rt55xx device support
CONFIG_RT2800USB_UNKNOWN=y              # [NH-RECOMMENDED][PORTED] unknown rt2800 USB devices

# ── MediaTek MT7601U ──────────────────────────────────────────────────────────
# MT7601U: very common cheap USB adapter; monitor mode limited per driver.
CONFIG_WLAN_VENDOR_MEDIATEK=y            # [NH-RECOMMENDED][PORTED] MediaTek vendor enable
CONFIG_MT7601U=y                         # [NH-RECOMMENDED][PORTED] MT7601U USB

# ── Realtek USB Wi-Fi Drivers ────────────────────────────────────────────────
# RTL8187: legacy; ALFA AWUS036H (older), Netgear WG111v2
# RTL8192CU: RTL8188CU, RTL8192CU family (TP-Link TL-WN727N etc.)
# RTL8XXXU: covers RTL8188EUS, RTL8192EU (in-kernel mac80211 driver)
CONFIG_WLAN_VENDOR_REALTEK=y             # [NH-REQUIRED][PORTED] Realtek vendor enable
CONFIG_RTL8187=y                         # [NH-RECOMMENDED][PORTED][MONITOR-CAPABLE][INJECT-CAPABLE]
CONFIG_RTL_CARDS=y                       # [NH-REQUIRED][PORTED] Realtek rtlwifi framework
CONFIG_RTL8192CU=y                       # [NH-RECOMMENDED][PORTED] RTL8192CU mac80211 driver
CONFIG_RTL8XXXU=y                        # [NH-RECOMMENDED][PORTED] RTL8xxx in-kernel driver
CONFIG_RTL8XXXU_UNTESTED=y              # [NH-RECOMMENDED][PORTED] Broader device support

# NOTE: RTL8812AU / RTL8814AU / RTL8811AU
# These are NOT in mainline kernel 5.10. They require out-of-tree drivers:
#   - aircrack-ng/rtl8812au
#   - morrownr/8814au
# These CANNOT be added via config fragment alone; they require source patches
# or external module compilation. Not included here.
# STATUS: REQUIRES SOURCE PATCH — deferred to future branch.
# See MARBLE_NETHUNTER_FEATURE_MANIFEST.md for details.

# ── ZyDAS USB Wi-Fi Drivers ──────────────────────────────────────────────────
CONFIG_WLAN_VENDOR_ZYDAS=y               # [NH-RECOMMENDED][PORTED] ZyDAS vendor enable
CONFIG_USB_ZD1201=y                      # [NH-RECOMMENDED][PORTED] ZD1201 USB
CONFIG_ZD1211RW=y                        # [NH-RECOMMENDED][PORTED][MONITOR-CAPABLE]

# ── Wireless RNDIS ───────────────────────────────────────────────────────────
CONFIG_USB_NET_RNDIS_WLAN=y              # [NH-RECOMMENDED][PORTED] Wireless RNDIS USB

# ── WIFI INJECTION STATUS ────────────────────────────────────────────────────
# Monitor mode and injection are driver-specific capabilities.
# Enabling the config options does NOT guarantee injection support.
#
# Known injection-capable drivers in this fragment:
#   ATH9K_HTC   — AR9271: monitor + injection (CONFIRMED via upstream docs)
#   RT2800USB   — monitor + injection on most chipsets (CONFIRMED via upstream)
#   RTL8187     — monitor + injection (CONFIRMED via upstream)
#   RT73USB     — monitor (CONFIRMED); injection limited
#   ZD1211RW    — monitor (CONFIRMED); injection limited
#
# NOT claimed: "Wi-Fi injection works on marble"
# STATUS: CONFIG CONFIRMED — BUILD + HARDWARE TESTING required
#
# Internal Qualcomm WLAN (qca_cld3_qca6490):
#   UNCHANGED. No modification to Qualcomm driver.
#   Monitor mode via internal WLAN: NOT SUPPORTED without proprietary changes.
